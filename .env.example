# Replace these placeholders with IDs from your own Entra app registration.
ENTRA_TENANT_ID=<YOUR_TENANT_ID>
ENTRA_API_CLIENT_ID=<YOUR_API_APPLICATION_ID>

# Use this exact URL in the plugin and the API app's identifierUris in Entra.
# The delegated scope is http://localhost:8001/mcp/access_as_user.
MCP_RESOURCE=http://localhost:8001/mcp

# Bind to loopback for local development.
MCP_HOST=127.0.0.1
MCP_PORT=8001
DATABASE_URL=sqlite://data/demo.db
MAX_CONNECTIONS=10
RUST_LOG=info

LLM_URL=http://localhost:11434/api/chat
LLM_MODEL=your-installed-model

# Optional for an authenticated endpoint implementing this API:
# LLM_API_KEY=...
